# Auto detect text files and normalize to LF
* text=auto eol=lf

# Windows scripts use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.so binary
*.a binary
*.o binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.zip binary
*.apk binary
